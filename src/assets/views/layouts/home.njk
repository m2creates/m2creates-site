{% extends "layouts/base.njk" %}

{% block content %}

  {# ══════════════════════════════════════════════════════════ #}
  {# HERO                                                       #}
  {# ══════════════════════════════════════════════════════════ #}
  <section class="relative flex flex-col min-h-screen px-6 pb-12 mx-auto overflow-hidden md:px-14 pt-28"
           aria-labelledby="hero-heading">

    {# Ghost background m² #}
    <span class="hidden lg:block absolute right-[-0.04em] top-1/2 -translate-y-[48%]
                 font-display font-semibold italic select-none pointer-events-none
                 leading-none text-[20vw] text-transparent
                 h-enter-fade d-7"
          aria-hidden="true"
          style="-webkit-text-stroke: 1px #C9BCA9;">m²</span>

    {# Coordinate watermark #}
    <div class="hidden md:block absolute top-32 right-14
                font-code text-[0.58rem] tracking-wider
                text-[#C9BCA9] text-right leading-loose
                h-enter-fade d-7"
         aria-hidden="true">
      30.2672° N<br>97.7431° W<br>Austin, TX
    </div>

    {# Main hero content #}
    <div class="flex flex-col justify-center flex-1 max-w-6xl px-6 md:px-14">

      <h1 id="hero-heading"
          class="h-enter d-2 font-display font-light italic leading-[1.05] text-[#1A1510] mb-8"
          style="font-size: clamp(2.8rem, 8vw, 6.2rem); letter-spacing: -0.015em;">
        I create things<br>while I pay attention.
      </h1>

      <p class="h-enter d-3 font-display text-[#4A4035] mb-10"
         style="font-size: clamp(1rem, 2.2vw, 1.45rem); letter-spacing: 0.01em;">
        How things work, where information goes missing, what gets overlooked, and what happens when you look a little closer.
      </p>

      <p class="h-enter d-4 font-code text-[0.65rem] tracking-widest text-[#7A6E65]">
        Melanie E. Magdalena
        <span class="mx-2 text-[#C9BCA9]">·</span>
        Austin, TX
      </p>

    </div>

  </section>

  <hr class="border-none h-px bg-gradient-to-r from-transparent via-[#C9BCA9] to-transparent">


  {# ══════════════════════════════════════════════════════════ #}
  {# THROUGHLINE                                                #}
  {# ══════════════════════════════════════════════════════════ #}
  <section id="throughline"
           class="max-w-6xl px-6 py-24 mx-auto md:px-14 md:py-32"
           aria-labelledby="throughline-heading">

    <p class="s-label reveal font-code text-[0.58rem] tracking-[0.2em] uppercase text-[#1C5B72] mb-14">
      The throughline
    </p>

    <div class="grid grid-cols-1 lg:grid-cols-[1fr_1.65fr] gap-14 lg:gap-28">

      {# Left: sticky label #}
      <div class="self-start reveal lg:sticky lg:top-28">
        <h2 id="throughline-heading"
            class="font-display font-light italic text-[#1A1510] leading-[1.1] mb-8"
            style="font-size: clamp(1.75rem, 3.2vw, 2.6rem);">
          Turns out, I keep doing this.
        </h2>
        <ul class="font-code text-[0.62rem] tracking-wider text-[#7A6E65]
                   leading-loose list-none m-0 p-0" aria-label="Career arc">
          <li>Archaeology →</li>
          <li>Digital Systems →</li>
          <li>Security →</li>
          <li>Logistics</li>
        </ul>
      </div>

      {# Right: narrative #}
      <div class="space-y-5 font-reading text-[1rem] leading-[1.85] text-[#4A4035]">

        <p class="reveal reveal-d1">
          At twenty, I published a spatial analysis of Maya settlements in Belize — mapping where people built, what moved between them, and what the gaps revealed about how a society organized itself around scarce resources.
        </p>

        <p class="reveal reveal-d3">
          Since then, I've built data systems for nonprofits and universities, redesigned security patrol routes around what a floor plan left out, and trained in a food bank warehouse to understand how food actually moves through the building and out to the community.
        </p>

        <p class="reveal reveal-d4">Very different jobs. But I keep getting interested in the same sort of thing: what's happening, what's missing, and what you can learn by looking closer.</p>

        {# Timeline tick marks #}
        <div class="relative pt-10 mt-6 reveal reveal-d4">
          <span class="absolute top-[1.4rem] left-0 right-0 h-px bg-[#C9BCA9]"
                aria-hidden="true"></span>
          <ol class="grid grid-cols-4 p-0 m-0 list-none">
            {% set timeline = [
              { year: "2012",    label: "Maya spatial\nanalysis\npublished, age 20" },
              { year: "2014–22", label: "Digital systems\narchitecture\nnonprofit & web" },
              { year: "2023–24", label: "Security\n& route design" },
              { year: "2024 →",  label: "Inventory, logistics\n& supply chain\nongoing" }
            ] %}
            {% for item in timeline %}
            <li class="relative pt-5 pr-2">
              <span class="absolute top-[-0.3rem] left-0 w-px h-3 bg-[#C9BCA9]"
                    aria-hidden="true"></span>
              <p class="font-code text-[0.58rem] tracking-wider text-[#1C5B72] mb-1">
                {{ item.year }}
              </p>
              <p class="font-code text-[0.56rem] tracking-wide text-[#7A6E65]
                        leading-relaxed whitespace-pre-line">
                {{ item.label }}
              </p>
            </li>
            {% endfor %}
          </ol>
        </div>

      </div>
    </div>
  </section>

  <hr class="border-none h-px bg-gradient-to-r from-transparent via-[#C9BCA9] to-transparent">

  {# ══════════════════════════════════════════════════════════ #}
  {# THREE LENSES                                               #}
  {# ══════════════════════════════════════════════════════════ #}
  <div class="w-full bg-[#EDE5D4]">
  <section class="max-w-6xl px-6 py-24 mx-auto md:px-14 md:py-32"
           aria-labelledby="lenses-heading">
    <p class="s-label reveal font-code text-[0.58rem] tracking-[0.2em] uppercase text-[#1C5B72] mb-14">
      What I tend to notice
    </p>

    <div class="grid grid-cols-1 md:grid-cols-3 divide-y md:divide-y-0 md:divide-x divide-[#C9BCA9] [&>*:first-child]:pl-0 [&>*:last-child]:pr-0">

      {% set lenses = [
        {
          num:   "01",
          word:  "What's missing",
          body:  "The information nobody recorded. The relationship nobody mapped. The detail that doesn't fit the explanation."
        },
        {
          num:   "02",
          word:  "What happens in real life",
          body:  "The spreadsheet says one thing. The warehouse floor says another. The plan meets the actual situation and something interesting happens."
        },
        {
          num:   "03",
          word:  "What shouldn't get lost",
          body:  "Records worth keeping, knowledge worth preserving, and information that needs to make sense to someone who wasn't there when it was created."
        }
      ] %}

      {% for lens in lenses %}
      <div class="reveal reveal-d{{ loop.index }} px-0 py-10 md:px-10 md:py-0 {% if not loop.first %}md:pl-10{% endif %}">
        <p class="font-code text-[0.58rem] tracking-[0.18em] text-[#C9BCA9] mb-4">
          {{ lens.num }}
        </p>
        <h3 class="font-display font-semibold text-[#1C5B72] mb-1"
            style="font-size: 1.6rem; letter-spacing: -0.01em;">
          {{ lens.word }}
        </h3>
        <p class="font-reading text-[0.93rem] leading-[1.8] text-[#4A4035]">
          {{ lens.body }}
        </p>
      </div>
      {% endfor %}

    </div>
  </section>
  </div>

  <hr class="border-none h-px bg-gradient-to-r from-transparent via-[#C9BCA9] to-transparent">

  {# ══════════════════════════════════════════════════════════ #}
  {# WORK                                                       #}
  {# ══════════════════════════════════════════════════════════ #}
  {#- Attention colors come from _data/attentionTypes.json, same as the Workshop cards. -#}
  {%- set dot = "inline-block w-[0.45em] h-[0.45em] rounded-full align-middle mr-[0.5em] -translate-y-[0.05em]" -%}

  <section class="max-w-6xl px-6 py-24 mx-auto md:px-14 md:py-32"
           aria-labelledby="work-heading">

    <div class="flex items-baseline justify-between mb-14">
      <p id="work-heading" class="s-label reveal font-code text-[0.58rem] tracking-[0.2em] uppercase text-[#1C5B72]">
        Selected work
      </p>
      <a href="/work/"
         class="font-code text-[0.6rem] tracking-[0.12em] uppercase text-[#7A6E65]
                hover:text-[#1C5B72] transition-colors border-b border-[#C9BCA9]
                hover:border-[#1C5B72]">
        The Workshop →
      </a>
    </div>

    {# Work cards — SP-forward order:
       1. CHC (live, mission-driven, Lane 2 primary evidence)
       2. SWPS / Austin Public (place, hands-on)
       3. Maya paper (origin story, intellectual depth signal)
       4. Portfolio (analytical work)
       Pattern: a sentence or two of situation, then the noticing in <strong>.
    #}
    <div class="grid grid-cols-1 gap-5 mx-auto md:grid-cols-2">

      {# ── Card 1: CHC ── #}
      {%- set a = attentionTypes.connection -%}
      <a href="/work/congressional-hunger-center/"
         class="work-card reveal reveal-d1
                group block bg-white border border-[#DDD4C4]
                p-8 no-underline"
         aria-label="Congressional Hunger Center — case study">
        <p class="font-code text-[0.56rem] tracking-[0.16em] uppercase mb-5"
           style="color: {{ a.color }};">
          <span aria-hidden="true" class="{{ dot }}" style="background-color: {{ a.color }};"></span><span class="sr-only">Attention to </span>{{ a.label }}
        </p>
        <h3 class="font-display font-light italic text-[#1A1510] leading-tight mb-3"
            style="font-size: clamp(1.4rem, 2.5vw, 1.9rem);">
          Congressional Hunger Center
        </h3>
        <p class="font-reading text-[0.92rem] leading-[1.75] text-[#4A4035] mb-6">
          How do you help fellows, partners, and alumni find their way through the same organization without flattening their different needs? I redesigned the digital platform around the relationships between its people, programs, and publications.
        </p>
        <p class="font-code text-[0.6rem] tracking-wider text-[#7A6E65]
                  group-hover:text-[#1C5B72] transition-colors">
          Read the case study →
        </p>
      </a>

      {# ── Card 2: SWPS ── #}
      {%- set a = attentionTypes.place -%}
      <a href="/work/swps-austin-public/"
        class="work-card reveal reveal-d2 group block no-underline
                bg-[#EDE5D4] border border-[#DDD4C4] p-8"
        aria-label="SWPS Experience Recording at Austin Public — case study">
        <p class="font-code text-[0.56rem] tracking-[0.16em] uppercase mb-5"
           style="color: {{ a.color }};">
          <span aria-hidden="true" class="{{ dot }}" style="background-color: {{ a.color }};"></span><span class="sr-only">Attention to </span>{{ a.label }}
        </p>
        <h3 class="font-display font-light italic text-[#1A1510] leading-tight mb-3"
            style="font-size: clamp(1.4rem, 2.5vw, 1.9rem);">
          SWPS Experience Recording at Austin Public
        </h3>
        <p class="font-reading text-[0.92rem] leading-[1.75] text-[#4A4035] mb-6">
          Seven cameras, three recording decks, and a live room that wouldn't sit still. My first time on Blackmagic hardware wasn't my first time thinking about how to capture a story across multiple sources.
        </p>
        <p class="font-code text-[0.6rem] tracking-wider text-[#7A6E65]
                  group-hover:text-[#1C5B72] transition-colors">
          Read the case study →
        </p>
      </a>

      {# ── Card 3: Maya Paper (dark card: label stays light for contrast) ── #}
      {%- set a = attentionTypes.place -%}
      <a href="https://drive.google.com/file/d/1M_AnkZwVMGHtMyWK8DppgLErJVlz-nhD/view"
         target="_blank" rel="noopener"
         class="work-card reveal reveal-d3
                group block bg-[#1C5B72] border border-[#1C5B72]
                p-8 no-underline"
         aria-label="The Maya of Belize — published 2012 (opens in a new tab)">
        <p class="font-code text-[0.56rem] tracking-[0.16em] uppercase text-[#D4E8EF]/70 mb-5">
          <span aria-hidden="true" class="{{ dot }} bg-[#D4E8EF]/70"></span><span class="sr-only">Attention to </span>{{ a.label }} · 2012
        </p>
        <h3 class="mb-3 italic font-light leading-tight text-white font-display"
            style="font-size: clamp(1.4rem, 2.5vw, 1.9rem);">
          The Maya of Belize
        </h3>
        <p class="font-reading text-[0.92rem] leading-[1.75] text-[#D4E8EF] mb-6">
          At twenty, I published a spatial analysis of Maya settlements in Belize—mapping where people built, what moved between them, and what the patterns could tell us about how people lived.
        </p>
        <p class="font-code text-[0.6rem] tracking-wider text-[#D4E8EF]/70
                  group-hover:text-white transition-colors">
          Read the paper ↗
        </p>
      </a>

      {# ── Card 4: Portfolio / Analytical work ── #}
      <a href="/work/"
         class="work-card reveal reveal-d4 group block no-underline
                border border-dashed border-[#C9BCA9] p-8">
        <p class="font-code text-[0.56rem] tracking-[0.16em] uppercase text-[#7A6E65] mb-5">
          {%- for key in ['boundaries', 'uncertainty', 'connection'] %}
          {%- set a = attentionTypes[key] %}
          <span class="mr-3 whitespace-nowrap" style="color: {{ a.color }};"><span aria-hidden="true" class="{{ dot }}" style="background-color: {{ a.color }};"></span>{{ a.label }}</span>
          {%- endfor %}
        </p>
        <h3 class="font-display font-light italic text-[#1A1510] leading-tight mb-3"
            style="font-size: clamp(1.4rem, 2.5vw, 1.9rem);">
          Inventory & Operations Analytics
        </h3>
        <p class="font-reading text-[0.92rem] leading-[1.75] text-[#4A4035] mb-6">
          I'm looking at what inventory systems capture, what they leave out, and what happens when the spreadsheet meets the warehouse floor.
        </p>
        <p class="font-code text-[0.6rem] tracking-wider text-[#7A6E65]
                  group-hover:text-[#1C5B72] transition-colors">
          Explore the Workshop →
        </p>
      </a>

    </div>
  </section>

{% endblock %}
