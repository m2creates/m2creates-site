{%- set shelf = postslist | workshopShelf -%}
{%- set completed = postslist | workshopCompleted -%}

{% if shelf | length %}
<section aria-labelledby="shelf-heading" class="mb-16">
  <h2 id="shelf-heading"
      class="font-code text-[0.6rem] tracking-[0.14em] uppercase text-[#8c6e3f] mb-6 text-center">
    On the Bench
  </h2>
  <ul class="grid grid-cols-1 gap-4 md:grid-cols-2" role="list">
    {%- for project in shelf -%}
      {% include "partials/project-card.njk" %}
    {%- endfor -%}
  </ul>
</section>
{% endif %}

<section aria-labelledby="completed-heading">
  <h2 id="completed-heading"
      class="font-code text-[0.6rem] tracking-[0.14em] uppercase text-[#8a8478] mb-6 text-center">
    Finished Work
  </h2>
  <ul class="grid grid-cols-1 gap-4 md:grid-cols-2" role="list">
    {%- for project in completed -%}
      {% include "partials/project-card.njk" %}
    {%- endfor -%}
  </ul>
</section>